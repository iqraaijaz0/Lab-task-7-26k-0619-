#include <stdio.h>

int main() {
    float marks[10];
    float sum = 0;
    float avg = 0;
    int count = 0;
    
    for (int i = 0; i < 10; i++) {
        while (1) {
            printf("Enter marks for student %d: ", i + 1);
            scanf("%f", &marks[i]);
            
            if (marks[i] >= 0 && marks[i] <= 20) {
                break;
            } else {
                printf("Wrong input! Enter again.\n");
            }
        }
        sum = sum + marks[i];
    }
    
    avg = sum / 10;
    
    printf("\nInitial Report:\n");
    for (int i = 0; i < 10; i++) {
        printf("Student %d: %.2f - ", i + 1, marks[i]);
        if (marks[i] >= 18) {
            printf("Excellent\n");
        } else if (marks[i] >= 14) {
            printf("Good\n");
        } else if (marks[i] >= 10) {
            printf("Average\n");
        } else {
            printf("Needs Improvement\n");
        }
        
        if (marks[i] > avg) {
            count++;
        }
    }
    
    printf("Average: %.2f\n", avg);
    printf("Students above average: %d\n", count);
    
    for (int i = 0; i < 10; i++) {
        marks[i] = marks[i] + 1.5;
        if (marks[i] > 20) {
            marks[i] = 20;
        }
    }
    
    printf("\nNew Report:\n");
    for (int i = 0; i < 10; i++) {
        printf("Student %d: %.2f - ", i + 1, marks[i]);
        if (marks[i] >= 18) {
            printf("Excellent\n");
        } else if (marks[i] >= 14) {
            printf("Good\n");
        } else if (marks[i] >= 10) {
            printf("Average\n");
        } else {
            printf("Needs Improvement\n");
        }
    }
    
    return 0;
}
